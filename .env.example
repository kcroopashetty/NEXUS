# NEXUS Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL

# Environment & Server
NEXUS_ENV=development
APP_NAME=NEXUS
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & Authentication
# In production (NEXUS_ENV=production), SECRET_KEY MUST be at least 32 cryptographically random characters
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40

# Database (PostgreSQL with pgvector for production/docker, SQLite supported for local dev/testing)
# PostgreSQL connection string with pgvector:
DATABASE_URL=postgresql+psycopg://nexus_user:nexus_password@localhost:5432/nexus_db
# For zero-dependency local dev or testing without running postgres:
# DATABASE_URL=sqlite:///./data/nexus.db

# Storage & File System
NEXUS_STORAGE_DIR=./data/nexus
MAX_UPLOAD_SIZE_BYTES=20971520
ALLOWED_EXTENSIONS=pdf,docx,txt

# Consolidated Vector Store (PostgreSQL + pgvector / ChromaDB)
VECTOR_STORE_BACKEND=postgres_pgvector
PGVECTOR_INDEX_TYPE=hnsw
PGVECTOR_M=16
PGVECTOR_EF_CONSTRUCTION=64
CHROMA_PERSIST_DIR=./data/chroma

# Local Inference & Embedding Models (Offline GPU Load Management)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=45
INFERENCE_CONCURRENCY_LIMIT=2
INFERENCE_QUEUE_LIMIT=16
INFERENCE_WAIT_TIMEOUT_SECONDS=30.0

# Guardrails & Grounding Verification
MIN_GROUNDING_SCORE=0.65
ENABLE_PERMISSION_GUARD=true
ENABLE_INTEGRITY_CHECK=true
ENABLE_QUALITY_INSPECTION=true
