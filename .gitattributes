# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Source code and documentation
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf

# Docker & Linux configuration
Dockerfile text eol=lf
*.sh text eol=lf
nginx.conf text eol=lf

# Windows specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

